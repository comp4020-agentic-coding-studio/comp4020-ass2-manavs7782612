---
import ContentLayout from "astro-theme-university/layouts/ContentLayout.astro";
import SessionsGrid from "../../components/SessionsGrid.astro";
import { sessionLabels, siteConfig } from "../../site-config";
---

<ContentLayout
  title={sessionLabels.plural}
  description={`The twelve-week teaching schedule: what happens in each ${sessionLabels.singular.toLowerCase()}, what to prepare, and what leaves the room.`}
  {...siteConfig}
>
  <p>
    One bread a week, in an order that builds on what came before: the plain
    loaf and baguette give way to sourdough and bagels, then the enriched and
    laminated doughs, before flatbreads close it out. You read the lecture
    before you arrive, work the dough at the bench, and leave each week with
    the notes that tell you what to change on the next one.
  </p>
  <SessionsGrid />
</ContentLayout>
